# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/campusconnect?retryWrites=true&w=majority

PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_characters
PUBLIC_API_URL=http://localhost:5000
NODE_ENV=development
SEED_DEMO=true
UPLOAD_DIR=uploads
AI_SERVICE_URL=http://127.0.0.1:8000
