{
  "name": "campusconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/src/server.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "start": "NODE_ENV=production node server/dist/server.js",
    "lint": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.10",
    "@vis.gl/react-google-maps": "^1.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.13.1",
    "multer": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
